NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Password reset and email confirmation redirect origin in production.
NEXT_PUBLIC_SITE_URL=https://www.meningyotoqxonam.uz
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Google Search Console "HTML tag" verification token (the content="..." value).
# Optional — only needed if verifying ownership via the meta tag instead of DNS.
GOOGLE_SITE_VERIFICATION=
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-domain.example
GEMINI_API_KEY=your-gemini-api-key
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
AI_GATEWAY_TEXT_MODEL=alibaba/qwen3.7-flash
AI_GATEWAY_TEXT_FALLBACKS=amazon/nova-micro,openai/gpt-oss-20b
AI_GATEWAY_VISION_MODEL=alibaba/qwen3.7-flash
AI_GATEWAY_VISION_FALLBACKS=amazon/nova-lite,openai/gpt-5-nano,google/gemini-2.5-flash-lite
GROQ_API_KEY=your-groq-api-key
GROQ_TEXT_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b,qwen/qwen3.8-27b
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Optional, dedicated administrator chat for internal alerts. Never use a student's chat ID.
TELEGRAM_ADMIN_CHAT_ID=your-admin-telegram-chat-id
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-a-32-character-random-secret
RATE_LIMIT_REDIS_REST_URL=https://your-redis-rest-endpoint
RATE_LIMIT_REDIS_REST_TOKEN=your-redis-rest-token
ADMIN_PORTAL_KEY=replace-with-a-long-random-secret
TARBIYACHI_PORTAL_KEY=replace-with-a-long-random-secret
DEKAN_PORTAL_KEY=replace-with-a-long-random-secret
DEKAN_REGISTER_CODE=replace-with-a-long-random-secret
# Set to "disabled" when dean registration is invite-only (recommended).
DEKAN_ALLOWED_IDS=disabled
CAPACITOR_SERVER_URL=https://your-domain.example
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=Yotoqxona tizimi <onboarding@resend.dev>
# Free SMTP fallback(s) for when Resend's daily quota runs out (lib/email.ts
# smtpAccounts()). Optional — sendMail() skips whatever isn't fully set.
# Tried in order: SMTP, then SMTP_2, then SMTP_3. Gmail: smtp.gmail.com, port
# 465, an App Password (myaccount.google.com/apppasswords, needs 2-Step
# Verification on first) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_2_HOST=
SMTP_2_PORT=
SMTP_2_USER=
SMTP_2_PASS=
SMTP_3_HOST=
SMTP_3_PORT=
SMTP_3_USER=
SMTP_3_PASS=
# Shared bearer secret for the yo'qlama (attendance) cron. Same value in the
# Vercel project env and the GitHub repo secret (.github/workflows/attendance.yml).
ATTENDANCE_CRON_SECRET=replace-with-a-long-random-secret
# Shared bearer secret for the visa/propiska reminder cron. Same value in the
# Vercel project env and the GitHub repo secret (.github/workflows/visa-reminders.yml);
# the workflow silently skips when it is missing.
VISA_CRON_SECRET=replace-with-a-long-random-secret
# Dedicated HMAC key for permanent ariza e-signatures (lib/ariza-signature.ts).
# Optional: when unset, SUPABASE_SERVICE_ROLE_KEY is used (legacy). Before
# rotating the service-role key, copy its OLD value into
# ARIZA_SIGNING_SECRET_LEGACY or every older signature stops verifying.
ARIZA_SIGNING_SECRET=
ARIZA_SIGNING_SECRET_LEGACY=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# supabase CLI local cache (project link/session state, not portable)
supabase/.temp/

# AI coding assistant local state (skill caches, agent config) - not app code
.agents/
.claude/
skills-lock.json
.codex-remote-attachments/

# local npm cache (accidental local NPM_CONFIG_CACHE target, not app code)
.npm-cache/
